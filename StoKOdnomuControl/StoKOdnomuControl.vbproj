  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <Target Name="PlaceRuntimeLibraries" AfterTargets="CopyFilesToOutputDirectory">
    <!-- Сначала копируем DLL из разрешённых ссылок, затем убираем только их
         стандартные копии в корне выходной папки. Исходники пакетов не меняем. -->
    <ItemGroup>
      <RuntimeLibrary Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeLibrary)" DestinationFiles="@(RuntimeLibrary->'$(TargetDir)lib\%(DestinationSubDirectory)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Delete Files="@(RuntimeLibrary->'$(TargetDir)%(DestinationSubDirectory)%(Filename)%(Extension)')" />
  </Target>
</Project>
