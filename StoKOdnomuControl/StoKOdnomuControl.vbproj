  <ItemGroup>
    <Content Include="..\profiles\**\*">
      <Link>lib\profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="*.txt">
      <!-- Поставляем все четыре базы, не только исторический base.txt. -->
      <Link>lib\bases\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Новый дизигн\static\JetBrainsMono-Regular.ttf;Новый дизигн\static\JetBrainsMono-Bold.ttf">
      <!-- BoardLayout загружает эти шрифты из lib/Fonts через GDI+, без установки в Windows. -->
      <Link>lib\Fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Новый дизигн\OFL.txt">
      <Link>lib\Fonts\OFL.txt</Link>
